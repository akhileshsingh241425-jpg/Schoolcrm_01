FLASK_APP=run.py
FLASK_ENV=development
CORS_ORIGINS=http://localhost:3000

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=school_crm
DB_USER=root
DB_PASSWORD=your_db_password

# Mail
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Paytm
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=DEFAULT
PAYTM_INDUSTRY_TYPE=Education
PAYTM_ENV=staging

# Redis
REDIS_URL=redis://localhost:6379/0

# Upload
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# WhatsApp Cloud API (Tata Telebusiness)
WHATSAPP_API_URL=https://wb.omni.tatatelebusiness.com/whatsapp-cloud/messages
WHATSAPP_AUTH_TOKEN=
WHATSAPP_PHONE=
WHATSAPP_TEMPLATE=pack_dispatch

# IVR Solutions Click-to-Call
IVR_API_URL=https://api.ivrsolutions.in/api/c2c_get
IVR_API_TOKEN=
IVR_DID_NO=
IVR_EXT_NO=

# Default Passwords (set strong values in production)
DEFAULT_STAFF_PASSWORD=
DEFAULT_STUDENT_PASSWORD=
DEFAULT_DIRECTOR_PASSWORD=

# Super admin credentials (used only for seeding)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
