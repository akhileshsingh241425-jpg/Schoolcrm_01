      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "http://93.127.194.235/api",
      "eas": {
        "projectId": "c8b70a24-8cc7-454c-8bcb-5a160b8fcb81"
      }
    },
    "owner": "akhilesh1407s-team",
    "plugins": [
      [
