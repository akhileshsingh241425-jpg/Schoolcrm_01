# ============================================
# School CRM - Production Environment Template
# Copy to /var/www/school-crm/backend/.env and
# replace all placeholders with real values.
# ============================================

# App Secret Keys — generate on server:
#   SECRET_KEY=$(openssl rand -hex 64)
#   JWT_SECRET_KEY=$(openssl rand -hex 32)
SECRET_KEY=
JWT_SECRET_KEY=

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Email SMTP
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Paytm
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=DEFAULT
PAYTM_INDUSTRY_TYPE=Education
PAYTM_ENV=staging

# Upload folder (server path)
UPLOAD_FOLDER=/var/www/school-crm/backend/uploads
MAX_CONTENT_LENGTH=16777216

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS — frontend domain(s), comma-separated
CORS_ORIGINS=https://your-domain.com

# WhatsApp Cloud API (Tata Telebusiness)
WHATSAPP_API_URL=https://wb.omni.tatatelebusiness.com/whatsapp-cloud/messages
WHATSAPP_AUTH_TOKEN=
WHATSAPP_PHONE=
WHATSAPP_TEMPLATE=pack_dispatch

# IVR Solutions Click-to-Call
IVR_API_URL=https://api.ivrsolutions.in/api/c2c_get
IVR_API_TOKEN=
IVR_DID_NO=
IVR_EXT_NO=

# Default passwords for seeded users (set strong values)
DEFAULT_STAFF_PASSWORD=
DEFAULT_STUDENT_PASSWORD=
DEFAULT_DIRECTOR_PASSWORD=

# Super admin credentials (for seeding on first run)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
